# =========================================================================
# GIBD WEB - CONFIGURACIÓN DE VARIABLES DE ENTORNO (FRONTEND)
# =========================================================================
#
# Para conectar la aplicación local con la base de datos real en Supabase,
# duplica este archivo como ".env.local" y rellena los siguientes valores.
#
# Nota de Robustez:
# Si estas variables no se configuran, la aplicación arrancará sin fallos
# (pantalla negra) y activará de manera automática el Modo Desarrollador Local
# (Mock Mode) persistiendo los datos de forma local en el localStorage.
#

# --- Supabase (CMS / Noticias / Papers / Equipo) ---
# Sin configurar: la app usa Mock Mode (localStorage) sin errores al arrancar.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# --- Backend de Inferencia (Laboratorio - modelos de visión y audio) ---
# Usado por src/utils/aiService.ts para llamar a los endpoints:
#   POST /api/v1/inference/siamese-brands
#   POST /api/v1/inference/soccer-crests
# Si no se define, se usa VITE_BACKEND_URL y, en último caso,
# el fallback http://localhost:8000.
VITE_API_URL=http://localhost:8000
# Alternativa histórica (mismo efecto que VITE_API_URL):
# VITE_BACKEND_URL=http://localhost:8000

# --- Cloudinary (subida de imágenes del Laboratorio) ---
# Opcional. Si no se configuran, CloudinaryUploader funciona 100% local:
# previsualización instantánea con el archivo en memoria (File object) y
# sin subida remota. Para habilitar la subida real (unsigned upload),
# crea un "Upload preset" sin firma (unsigned) en tu consola de Cloudinary
# y completa ambas variables:
#   Cloud -> Settings -> Upload -> Upload presets -> "Enable unsigned uploading"
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=tu-upload-preset-unsigned

