# =========================================================================
# GIBD WEB - CONFIGURACIÓN DE VARIABLES DE ENTORNO (FRONTEND)
# =========================================================================
#
# Para conectar la aplicación local con la base de datos real en Supabase,
# Cloudinary y el API Gateway de FastAPI, duplica este archivo como ".env.local"
# y rellena los siguientes valores.
#
# Nota de Robustez:
# Si estas variables no se configuran, la aplicación arrancará sin fallos
# (pantalla negra) y activará de manera automática el Modo Autónomo Local
# (Zero-Cost / Fallback) persistiendo los datos y procesando inferencias
# de forma local en el navegador.
#

# Base de datos y Autenticación Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# Cloudinary - Pipeline de Almacenamiento y Optimización en el Edge
# Requiere un Upload Preset en modo "Unsigned" configurado en Cloudinary Console.
# Si se omiten estas variables o no hay conexión, se activa el fallback local a FileReader.
VITE_CLOUDINARY_CLOUD_NAME=gibd-utn
VITE_CLOUDINARY_UPLOAD_PRESET=gibd_lab_unsigned

# API Gateway Backend (FastAPI / Motores de Inferencia en CPU)
# En desarrollo local dejar vacío para usar el proxy de Vite o configurar http://localhost:8000
VITE_API_BASE_URL=
